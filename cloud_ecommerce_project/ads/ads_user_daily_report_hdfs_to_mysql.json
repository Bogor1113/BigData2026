{
  "job": {
    "setting": {
      "speed": {
        "channel": 2
      },
      "errorLimit": {
        "record": 0,
        "percentage": 0.02
      }
    },
    "content": [
      {
        "reader": {
          "name": "hdfsreader",
          "parameter": {
            "path": "/hive3/warehouse/ads.db/ads_user_daily_report/stat_date=${stat_date}",
            "defaultFS": "hdfs://192.168.42.101:8020",
            "column": [
              {"index": -1, "type": "string", "value": "${stat_date}"},
              {"index": 0, "type": "long"},
              {"index": 1, "type": "long"},
              {"index": 2, "type": "long"},
              {"index": 3, "type": "string"},
              {"index": 4, "type": "long"},
              {"index": 5, "type": "string"},
              {"index": 6, "type": "string"},
              {"index": 7, "type": "string"},
              {"index": 8, "type": "string"},
              {"index": 9, "type": "string"},
              {"index": 10, "type": "string"}
            ],
            "fileType": "text",
            "encoding": "UTF-8",
            "fieldDelimiter": "\u0001"
          }
        },
        "writer": {
          "name": "mysqlwriter",
          "parameter": {
            "username": "root",
            "password": "123456",
            "column": [
              "stat_date",
              "valid_users_count",
              "daily_active_users",
              "order_count",
              "order_amount",
              "pay_order_count",
              "pay_amount",
              "order_conversion_rate",
              "pay_conversion_rate",
              "avg_order_amount",
              "order_count_dod_rate",
              "pay_amount_dod_rate"
            ],
            "writeMode": "replace",
            "connection": [
              {
                "jdbcUrl": "jdbc:mysql://192.168.42.101:3306/ads?useUnicode=true&characterEncoding=utf8&useSSL=false",
                "table": ["ads_user_daily_report"]
              }
            ]
          }
        }
      }
    ]
  }
}
